---
// The one card used in grids: emoji, title, one line, and actions.
// Give an action the `stretched` class to make the whole card its target.

interface Props {
	title: string;
	description?: string;
	/** Glyph shown above the title. */
	emoji?: string;
	/** Short metadata at the end of the title line. */
	meta?: string;
	/** Greys the title out, for items that are no longer active. */
	muted?: boolean;
}

const { title, description, emoji, meta, muted } = Astro.props;
---

<article class="grid-item">
	{emoji && <span class="mb-3 text-3xl leading-none" aria-hidden="true">{emoji}</span>}
	<h3 class:list={["grid-item-title", { "text-neutral-content": muted }]}>
		{title}
		{meta && <span class="entry-trail font-normal tabular-nums">{meta}</span>}
	</h3>
	{description && <p class="grid-item-description">{description}</p>}
	{Astro.slots.has("default") && <div class="grid-item-actions"><slot /></div>}
</article>
