---
import { Menu, Search as SearchIcon, Volume2, VolumeX, Sun, Moon, SunMoon } from "@lucide/astro";

// Publications and projects are sections of the homepage, not pages of their own.
let links = [
  { href: "/#about", label: "About" },
  { href: "/#papers", label: "Publications" },
  { href: "/#projects", label: "Projects" },
  { href: "/playground", label: "Playground" },
];

// Anchor links only resolve their section client-side (the hash never reaches the server),
// so this just seeds the initial state; [data-header] script keeps it in sync on scroll/hash change.
const { pathname, hash } = Astro.url;
// The static build serves pages at a trailing-slash URL (e.g. "/playground/"), but nav hrefs
// are written without one, so the comparison has to ignore it.
const stripTrailingSlash = (path: string) => (path.length > 1 ? path.replace(/\/$/, "") : path);
function isActive(href: string) {
  const [path, linkHash] = href.split("#");
  if (stripTrailingSlash(path) !== stripTrailingSlash(pathname)) return false;
  return linkHash ? hash === `#${linkHash}` : hash === "";
}

if (pathname !== "/") {
  links = [
    { href: "/", label: "Home" },
    ...links,
  ];
}
---

<header class="w-full" data-header>
  <div class="container mx-auto p-4 md:p-5 md:px-12 md:max-w-4xl flex items-center gap-4">
    <a href="/" aria-label="Logo of Jack" class="max-w-fit shrink-0" data-cuelume-press="whisper" data-cuelume-hover="tick" data-cuelume-release="sparkle" data-haptic-press="error">
      <svg
        id="logo"
        class="max-h-8 w-10 transition-fill fill-base-content group"
        viewBox="0 0 942 1000"
        version="1.1"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        xml:space="preserve"
        style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"
      >
        <g transform="matrix(1,0,0,1,-383.556,-420.583)">
          <path
            class="group-hover:fill-accent-2 transition-all"
            d="M544.989,1122.5C579.959,1152.47 625.389,1170.58 675.017,1170.58C785.4,1170.58 875.017,1080.97 875.017,970.583L1125.02,970.583C1125.02,1218.94 923.379,1420.58 675.017,1420.58C563.875,1420.58 462.09,1380.2 383.556,1313.34L544.989,1122.5Z"
          ></path>
          <path
            class="group-hover:fill-accent-3 transition-all"
            d="M1324.98,420.583L1324.98,670.583C1214.6,670.583 1124.98,760.2 1124.98,870.583L874.983,870.583C874.983,622.221 1076.62,420.583 1324.98,420.583Z"
          ></path>
          <path
            class="group-hover:fill-accent-1 transition-all "
            d="M1008.84,420.583C921.088,482.377 852.184,569.178 812.535,670.583L540.994,670.583L540.994,420.583L1008.84,420.583Z"
          ></path>
        </g>
      </svg>
    </a>

    <nav class="ml-auto hidden md:flex items-center gap-6 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          class:list={{ "nav-link--playground": link.href === "/playground" }}
          aria-current={isActive(link.href) ? "page" : undefined}
          data-cuelume-release="arrival" data-cuelume-hover="tick"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto md:ml-0 flex items-center gap-1">
        <button type="button" class="icon-btn" data-search-open aria-label="Search" data-cuelume-press="bloom" data-cuelume-hover="tick" data-haptic-press="light">
        <SearchIcon size={18} stroke-width={1.75} />
      </button>
      <button type="button" class="icon-btn" data-sound-toggle aria-label="Mute sound" aria-pressed="false" data-cuelume-hover="tick" data-cuelume-press data-haptic-toggle="selection">
        <span data-sound-icon-on><Volume2 size={18} stroke-width={1.75} /></span>
        <span data-sound-icon-off hidden><VolumeX size={18} stroke-width={1.75} /></span>
      </button>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Theme: auto" data-cuelume-hover="tick" data-cuelume-press data-haptic-toggle="selection">
        <span data-theme-icon-auto><SunMoon size={18} stroke-width={1.75} /></span>
        <span data-theme-icon-light hidden><Sun size={18} stroke-width={1.75} /></span>
        <span data-theme-icon-dark hidden><Moon size={18} stroke-width={1.75} /></span>
      </button>
      <button type="button" class="icon-btn md:hidden" data-menu-toggle aria-expanded="false" aria-controls="header-menu" aria-label="Menu" data-cuelume-press="scan" data-haptic-press="light">
        <Menu size={20} stroke-width={1.75} />
      </button>
    </div>
  </div>

  {/* The links the desktop nav shows inline, folded away behind the hamburger. */}
  <div id="header-menu" data-header-menu hidden class="md:hidden border-t border-base-300/60">
    <nav class="container mx-auto p-4 md:max-w-4xl flex flex-col">
      {links.map((link) => (
        <a
          href={link.href}
          class="nav-link py-2"
          class:list={{ "nav-link--playground": link.href === "/playground" }}
          aria-current={isActive(link.href) ? "page" : undefined}
          data-cuelume-press
          data-haptic-press="light"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  import { isSoundEnabled, setSoundEnabled } from "../utils/sounds";
  import { getStoredTheme, applyTheme, cycleTheme, type Theme } from "../utils/theme";

  // View transitions swap in the new page's DOM (fetched via fetch(), so its inline <head>
  // script never ran) before "astro:page-load" fires, which briefly shows the default theme
  // until this reapplies the stored one. This script tag itself persists across transitions
  // (Astro dedupes identical head scripts), so registering the listener once here is enough.
  document.addEventListener("astro:after-swap", () => applyTheme(getStoredTheme()));

  function setupSoundToggle() {
    const btn = document.querySelector<HTMLButtonElement>("[data-sound-toggle]");
    const onIcon = btn?.querySelector<HTMLElement>("[data-sound-icon-on]");
    const offIcon = btn?.querySelector<HTMLElement>("[data-sound-icon-off]");
    if (!btn || !onIcon || !offIcon) return;

    function render(enabled: boolean) {
      btn!.setAttribute("aria-pressed", String(!enabled));
      btn!.setAttribute("aria-label", enabled ? "Mute sound" : "Unmute sound");
      onIcon!.hidden = !enabled;
      offIcon!.hidden = enabled;
    }

    render(isSoundEnabled());

    btn.addEventListener("click", () => {
      const next = !isSoundEnabled();
      setSoundEnabled(next);
      render(next);
    });
  }

  function setupThemeToggle() {
    const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const autoIcon = btn?.querySelector<HTMLElement>("[data-theme-icon-auto]");
    const lightIcon = btn?.querySelector<HTMLElement>("[data-theme-icon-light]");
    const darkIcon = btn?.querySelector<HTMLElement>("[data-theme-icon-dark]");
    if (!btn || !autoIcon || !lightIcon || !darkIcon) return;

    const labels: Record<Theme, string> = {
      auto: "Theme: auto",
      light: "Theme: light",
      dark: "Theme: dark",
    };

    function render(theme: Theme) {
      btn!.setAttribute("aria-label", labels[theme]);
      autoIcon!.hidden = theme !== "auto";
      lightIcon!.hidden = theme !== "light";
      darkIcon!.hidden = theme !== "dark";
    }

    render(getStoredTheme());

    btn.addEventListener("click", () => {
      render(cycleTheme());
    });
  }

  function setupHeader() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-header-menu]");
    if (!toggle || !menu) return;

    function setOpen(open: boolean) {
      menu!.hidden = !open;
      toggle!.setAttribute("aria-expanded", String(open));
    }

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Following a link would otherwise leave the menu open across a transition.
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    // The search dialog covers the menu, so fold it away when it opens.
    document.querySelector("[data-search-open]")?.addEventListener("click", () => setOpen(false));
  }

  // Hash-only navigation (the homepage's #about/#papers/#projects anchors) never triggers a
  // fresh Astro render, so the active link has to be kept in sync manually here. On the
  // homepage itself, scrolling past a section should update the active link (and the URL
  // hash) the same way clicking its nav link would.
  function setupActiveLink() {
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-header] .nav-link");
    // Listeners attach to window/document, which survive view-transition swaps, so they're
    // torn down explicitly before the next page's setup runs.
    const controller = new AbortController();
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true });

    // Same trailing-slash quirk as the server-side isActive() above: the "/playground" href
    // never matches the "/playground/" the browser actually navigates to without this.
    const stripTrailingSlash = (path: string) => (path.length > 1 ? path.replace(/\/$/, "") : path);
    function setActive(hash: string) {
      links.forEach((link) => {
        const matches = stripTrailingSlash(link.pathname) === stripTrailingSlash(location.pathname) && link.hash === hash;
        if (matches) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }

    setActive(location.hash);

    const sections = ["about", "papers", "projects"]
      .map((id) => {
        const el = document.getElementById(id);
        return el ? { hash: `#${id}`, top: el.offsetTop } : null;
      })
      .filter((entry): entry is { hash: string; top: number } => entry !== null);

    if (location.pathname !== "/" || sections.length === 0) {
      window.addEventListener("hashchange", () => setActive(location.hash), { signal: controller.signal });
      return;
    }

    // A single scroll-position check (rather than an IntersectionObserver watching each section)
    // avoids two async signals racing to decide the active link near the top of the page.
    let ticking = false;
    function updateFromScroll() {
      ticking = false;
      // A small fixed offset (not a fraction of viewport height) keeps the trigger pinned just
      // below the header: "about" starts right under it, so a percentage-based lookahead would
      // always overshoot into it and Home could never be active.
      const line = window.scrollY + 96;
      let hash = "";
      for (const section of sections) {
        if (line >= section.top) hash = section.hash;
      }
      if (hash !== location.hash) history.replaceState(null, "", hash || location.pathname);
      setActive(hash);
    }

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateFromScroll);
      },
      { passive: true, signal: controller.signal },
    );

    updateFromScroll();
    window.addEventListener("hashchange", () => setActive(location.hash), { signal: controller.signal });
  }

  document.addEventListener("astro:page-load", () => {
    setupHeader();
    setupActiveLink();
    setupSoundToggle();
    setupThemeToggle();
  });
</script>
