---
import Button from "./Button.astro";
import Icon from "./Icon.astro";

let links = [
  { href: "/", label: "About" },
  { href: "/research", label: "Research" },
  { href: "/projects", label: "Projects" },
  { href: "/apps", label: "Apps" },
];

const { pathname } = Astro.url;
// The static build serves pages at a trailing-slash URL (e.g. "/apps/"), but nav hrefs
// are written without one, so the comparison has to ignore it.
const stripTrailingSlash = (path: string) => (path.length > 1 ? path.replace(/\/$/, "") : path);
function isActive(href: string) {
  return stripTrailingSlash(href) === stripTrailingSlash(pathname);
}
---

<header class="w-full" data-header>
  <div class="shell flex items-center gap-4">
    <a href="/" aria-label="Logo of Jack" class="max-w-fit shrink-0" data-cuelume-press="whisper" data-cuelume-hover="tick" data-cuelume-release="sparkle" data-haptic-press="error">
      <svg
        id="logo"
        class="max-h-8 w-10 transition-fill fill-base-content group"
        viewBox="0 0 942 1000"
        version="1.1"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        xml:space="preserve"
        style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"
      >
        <g transform="matrix(1,0,0,1,-383.556,-420.583)">
          <path
            class="group-hover:fill-accent transition-all"
            d="M544.989,1122.5C579.959,1152.47 625.389,1170.58 675.017,1170.58C785.4,1170.58 875.017,1080.97 875.017,970.583L1125.02,970.583C1125.02,1218.94 923.379,1420.58 675.017,1420.58C563.875,1420.58 462.09,1380.2 383.556,1313.34L544.989,1122.5Z"
          ></path>
          <path
            class="group-hover:fill-accent transition-all"
            d="M1324.98,420.583L1324.98,670.583C1214.6,670.583 1124.98,760.2 1124.98,870.583L874.983,870.583C874.983,622.221 1076.62,420.583 1324.98,420.583Z"
          ></path>
          <path
            class="group-hover:fill-accent transition-all "
            d="M1008.84,420.583C921.088,482.377 852.184,569.178 812.535,670.583L540.994,670.583L540.994,420.583L1008.84,420.583Z"
          ></path>
        </g>
      </svg>
    </a>

    <nav class="ml-auto hidden md:flex items-center gap-1 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class="link nav-link"
          aria-current={isActive(link.href) ? "page" : undefined}
          data-cuelume-release="arrival" data-cuelume-hover="tick"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto md:ml-0 flex items-center gap-1">
        <Button variant="icon" data-search-open aria-label="Search" data-cuelume-press="bloom" data-haptic-press="light">
        <Icon name="search" />
      </Button>
      <Button variant="icon" data-sound-toggle aria-label="Mute sound" aria-pressed="false" data-haptic-toggle="selection">
        <span data-sound-icon-on><Icon name="sound-high" /></span>
        <span data-sound-icon-off hidden><Icon name="sound-off" /></span>
      </Button>
      <Button variant="icon" data-theme-toggle aria-label="Theme: auto" data-haptic-toggle="selection">
        <span data-theme-icon-auto><Icon name="light-bulb" /></span>
        <span data-theme-icon-light hidden><Icon name="light-bulb-on" /></span>
        <span data-theme-icon-dark hidden><Icon name="light-bulb-off" /></span>
      </Button>
      <Button variant="icon" class="md:hidden" data-menu-toggle aria-expanded="false" aria-controls="header-menu" aria-label="Menu" data-cuelume-press="scan" data-haptic-press="light">
        <Icon name="menu" size={20} />
      </Button>
    </div>
  </div>

  {/* The links the desktop nav shows inline, folded away behind the hamburger. */}
  <div id="header-menu" data-header-menu hidden class="md:hidden border-t border-base-300">
    <nav class="shell flex flex-col">
      {links.map((link) => (
        <a
          href={link.href}
          class="link nav-link -mx-3 py-2"
          aria-current={isActive(link.href) ? "page" : undefined}
          data-cuelume-press
          data-haptic-press="light"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  import { isSoundEnabled, setSoundEnabled } from "../utils/sounds";
  import { getStoredTheme, applyTheme, cycleTheme, type Theme } from "../utils/theme";

  // This module runs once and the document outlives ClientRouter swaps, so the
  // listeners are delegated to it: they work on the first load (where
  // "astro:page-load" may already have fired) and on every page swapped in later.

  const themeLabels: Record<Theme, string> = {
    auto: "Theme: auto",
    light: "Theme: light",
    dark: "Theme: dark",
  };

  // Show the icon and label of the current theme on the toggle.
  function renderThemeToggle(theme: Theme = getStoredTheme()) {
    const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    if (!btn) return;
    btn.setAttribute("aria-label", themeLabels[theme]);
    btn.querySelectorAll<HTMLElement>("[data-theme-icon-auto], [data-theme-icon-light], [data-theme-icon-dark]").forEach((icon) => {
      icon.hidden = !icon.hasAttribute(`data-theme-icon-${theme}`);
    });
  }

  // Show the icon and label of the current sound state on the toggle.
  function renderSoundToggle(enabled: boolean = isSoundEnabled()) {
    const btn = document.querySelector<HTMLButtonElement>("[data-sound-toggle]");
    if (!btn) return;
    btn.setAttribute("aria-pressed", String(!enabled));
    btn.setAttribute("aria-label", enabled ? "Mute sound" : "Unmute sound");
    btn.querySelector<HTMLElement>("[data-sound-icon-on]")!.hidden = !enabled;
    btn.querySelector<HTMLElement>("[data-sound-icon-off]")!.hidden = enabled;
  }

  function setMenuOpen(open: boolean) {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-header-menu]");
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Element;

    if (target.closest("[data-theme-toggle]")) {
      renderThemeToggle(cycleTheme());
      return;
    }

    if (target.closest("[data-sound-toggle]")) {
      const enabled = !isSoundEnabled();
      setSoundEnabled(enabled);
      renderSoundToggle(enabled);
      return;
    }

    const menuToggle = target.closest("[data-menu-toggle]");
    if (menuToggle) {
      setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
      return;
    }

    // Following a menu link would otherwise leave the menu open across a
    // transition, and the search dialog covers the menu when it opens.
    if (target.closest("[data-header-menu] a, [data-search-open]")) setMenuOpen(false);
  });

  // The swapped-in page was fetched, so its inline <head> theme script never
  // ran: reapply the stored theme before it paints.
  document.addEventListener("astro:after-swap", () => applyTheme(getStoredTheme()));
  document.addEventListener("astro:page-load", () => {
    renderThemeToggle();
    renderSoundToggle();
  });
  renderThemeToggle();
  renderSoundToggle();
</script>
