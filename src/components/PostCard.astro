---
import FormattedDate from "../components/FormattedDate.astro";

type Props = {
  title?: string;
  pubDate?: Date;
  description?: string;
  slug?: string;
  summary?: string;
  categories?: string[];
  featured?: Boolean;
  trending?: Boolean;
  cta?: string[];
  location?: string;
  authors?: string;
  venue?: string;
  unavailable?: boolean;
};

const { ...props } = Astro.props;
const MyTag = props.slug ? 'a' : 'div';

const accent = props.featured && !props.trending
  ? "accent-3"
  : props.trending
    ? "accent-2"
    : null;
---

<MyTag
  class:list={[
    "group block card p-4 md:p-5",
    { "card-hover cursor-pointer": props.slug },
    { "opacity-60": props.unavailable },
  ]}
  href={props.slug}
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      {(props.featured || props.trending) && (
        <span class:list={["eyebrow", accent === "accent-3" ? "text-accent-3" : "text-accent-2"]}>
          {props.featured ? "Featured" : "Trending"}
        </span>
      )}
      <p class="mt-0.5 font-display font-bold text-base-content group-hover:text-accent-1 transition-colors">
        <span class:list={[{ "line-through": props.unavailable === true }]}>{props.title}</span>
      </p>

      {props.summary && <p class="text-sm text-neutral-content mt-1">{props.summary}</p>}

      <p class="text-xs text-neutral-content mt-2 flex flex-wrap gap-x-2 gap-y-0.5">
        {props.authors && <span>{props.authors}</span>}
        {props.venue && <span class="font-bold text-base-content/80">{props.venue}</span>}
        {props.location && <span>{props.location}</span>}
        {props.pubDate && (
          <span>
            <FormattedDate date={props.pubDate} />
          </span>
        )}
      </p>
    </div>

    {props.cta && (
      <a
        href={props.cta[1]}
        class="shrink-0 text-xs px-3 py-1.5 rounded-lg border border-base-300 text-neutral-content hover:text-base-content hover:border-base-content transition-colors"
      >
        {props.cta[0]}
      </a>
    )}
  </div>
</MyTag>
