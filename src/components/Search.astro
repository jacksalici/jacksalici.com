---
// Site-wide search dialog, backed by Pagefind. Rendered once per page by the
// Base layout and opened by any `[data-search-open]` trigger.
// The index is generated from the built HTML by the `postbuild` script, so
// search only answers on a built site (`npm run build && npm run preview`).
import Button from "./Button.astro";
import List from "./List.astro";
import Icon from "./Icon.astro";
---

<dialog id="search-dialog" class="dialog" aria-label="Search the site">
  <div class="flex items-center gap-2">
    <!-- Not type="search": Chromium lets it swallow Escape instead of closing the dialog. -->
    <input
      type="text"
      data-search-input
      class="search-input"
      placeholder="Search everything I have made…"
      autocomplete="off"
      aria-label="Search the site"
    />
    <Button variant="icon" data-search-close aria-label="Close search">
      <Icon name="xmark" />
    </Button>
  </div>

  <p data-search-status class="eyebrow mt-3" hidden></p>
  <List class="mt-1" data-search-results />
</dialog>

<script>
  const MAX_RESULTS = 8;

  // Human label for a result, derived from the first segment of its URL.
  // Only detail pages (two segments) get one: "/research" itself is a page.
  const TYPES: Record<string, string> = {
    research: "Paper",
    projects: "Project",
    notes: "Note",
    market: "Garage sale",
    activities: "Activity",
  };

  function typeOf(url: string) {
    const [segment, slug] = url.replace(/^\//, "").split("/");
    return (slug && TYPES[segment]) || "Page";
  }

  let pagefind: any = null;
  let unavailable = false;

  // Pagefind is emitted into `dist` after the Astro build, so it must stay out
  // of Vite's dependency graph: a plain dynamic import here gets wrapped in
  // Vite's preload helper and breaks at runtime.
  const loadPagefindModule = new Function(
    "return import('/pagefind/pagefind.js')"
  ) as () => Promise<any>;

  async function getPagefind() {
    if (pagefind || unavailable) return pagefind;
    try {
      pagefind = await loadPagefindModule();
      await pagefind.init();
    } catch {
      unavailable = true;
    }
    return pagefind;
  }

  // Builds the same markup as ListItem.astro, so results look like any other list.
  function renderResult(data: any) {
    const el = (tag: string, className: string, text = "") => {
      const node = document.createElement(tag);
      node.className = className;
      node.textContent = text;
      return node;
    };

    const link = el("a", "entry") as HTMLAnchorElement;
    link.href = data.url;
    link.dataset.cuelumeHover = "tick";
    link.dataset.cuelumePress = "success";

    const excerpt = el("span", "entry-description");
    excerpt.innerHTML = data.excerpt; // Pagefind escapes the text and adds <mark>.

    const body = el("span", "entry-body");
    body.append(el("span", "entry-title", data.meta?.title ?? data.url), excerpt);

    const trail = el("span", "entry-trail");
    trail.append(el("span", "chip", typeOf(data.url)));

    link.append(body, trail);
    const item = document.createElement("li");
    item.append(link);
    return item;
  }

  function setupSearch() {
    const dialog = document.querySelector<HTMLDialogElement>("#search-dialog");
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = "true";

    const input = dialog.querySelector<HTMLInputElement>("[data-search-input]");
    const list = dialog.querySelector<HTMLElement>("[data-search-results]");
    const status = dialog.querySelector<HTMLElement>("[data-search-status]");
    if (!input || !list || !status) return;

    function say(message: string) {
      status!.textContent = message;
      status!.hidden = message === "";
    }

    document.querySelectorAll("[data-search-open]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        dialog.showModal();
        input.focus();
        getPagefind(); // Warm the index up while the first word is typed.
      });
    });

    dialog.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close());

    // Clicking the backdrop lands on the dialog element itself.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    input.addEventListener("input", async () => {
      const query = input.value.trim();
      if (query.length < 2) {
        list.replaceChildren();
        say("");
        return;
      }

      const engine = await getPagefind();
      if (!engine) {
        say("Search index unavailable — it is built with the site.");
        return;
      }

      // Returns null when a newer keystroke has superseded this search.
      const search = await engine.debouncedSearch(query, {}, 200);
      if (!search) return;

      const results = await Promise.all(
        search.results.slice(0, MAX_RESULTS).map((r: any) => r.data())
      );

      list.replaceChildren(...results.map(renderResult));
      say(
        search.results.length === 0
          ? `No results for “${query}”`
          : `${search.results.length} result${search.results.length > 1 ? "s" : ""}`
      );
    });
  }

  // `astro:page-load` can fire before this module runs on the first load, so
  // bind right away too; the ClientRouter swaps in fresh elements on every
  // navigation, and the `bound` flag keeps each dialog to a single binding.
  setupSearch();
  document.addEventListener("astro:page-load", setupSearch);
</script>
