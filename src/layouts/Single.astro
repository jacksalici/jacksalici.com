---
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Gallery from '../components/Gallery.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import Base from './Base.astro';
import { categories } from '../consts';

const { ...props } = Astro.props;

const hasEyebrow = props.pubDate || props.updatedDate || props.categories || props.featured || props.trending;
---

<Base
	title={props?.title}
	description={props?.news ?? props?.summary ?? props?.description}
	summary={props?.summary}
	tags={props?.tags}
	categories={props?.categories}
	image={props?.cover}
	cover={props?.cover}
	pubDate={props?.pubDate}
	updatedDate={props?.updatedDate}
	authors={props?.authors}
	pageType="article"
	noindex={props?.noindex}
>
	<main>
		<PageHeader title={props.title} lead={props.summary ?? props.description}>
			{hasEyebrow && (
				<Fragment slot="eyebrow">
					{props.pubDate && <span>Published <FormattedDate date={props.pubDate} /></span>}
					{props.updatedDate && <span>~ Updated <FormattedDate date={props.updatedDate} /></span>}
					{props.categories && <span>~ {props.categories.map((c: string) => categories[c] ?? c).join(', ')}</span>}
					{props.featured && <Chip tone="accent">Featured</Chip>}
					{props.trending && <Chip tone="accent">Trending</Chip>}
				</Fragment>
			)}
			{(props.authors || props.venue) && (
				<Fragment slot="after">
					{props.authors && <p>{props.authors}</p>}
					{props.venue && <p class="mt-1 font-medium text-base-content">{props.venue}</p>}
				</Fragment>
			)}
		</PageHeader>

		{/* Gallery, right under the header: the pictures set the scene before the text. */}
		{props.gallery && props.gallery.length > 0 && (
			<div class="mb-12">
				<Gallery items={props.gallery} />
			</div>
		)}

		<Prose>
			<slot />
		</Prose>

		{props.cta && (
			<div class="flex flex-wrap gap-2">
				{props.cta.map((item: { url: string; label: string }, i: number) => (
					<Button href={item.url} variant={i === 0 ? "solid" : "outline"}>
						{item.label}&nbsp;↗
					</Button>
				))}
			</div>
		)}
	</main>
</Base>
