---
import FormattedDate from '../components/FormattedDate.astro';
import Gallery from '../components/Gallery.astro';
import Base from './Base.astro';
import { categories } from '../consts';

const { ...props } = Astro.props;
---

<Base
	title={props?.title}
	description={props?.news ?? props?.summary ?? props?.description}
	summary={props?.summary}
	tags={props?.tags}
	categories={props?.categories}
	image={props?.cover}
	cover={props?.cover}
	pubDate={props?.pubDate}
	updatedDate={props?.updatedDate}
	authors={props?.authors}
	pageType="article"
>
	<main>
		{/* Header section */}
		<div class="w-full mb-12">
			{/* Featured/Trending badges */}
			{(props.featured || props.trending) && (
				<div class="text-xs mb-3 flex gap-3">
					{props.featured && <span class="eyebrow text-accent-3">Featured</span>}
					{props.trending && <span class="eyebrow text-accent-2">Trending</span>}
				</div>
			)}

			{/* Metadata */}
			<p class="eyebrow mb-3 flex flex-wrap gap-x-2">
				{props.pubDate && <span>Published <FormattedDate date={props.pubDate} /></span>}
				{props.updatedDate && <span>~ Updated <FormattedDate date={props.updatedDate} /></span>}
				{props.categories && <span>~ {props.categories.map((c: string) => categories[c] ?? c).join(', ')}</span>}
				{props.location && <span>~ {props.location}</span>}
				{props.stack && <span>~ {props.stack.join(', ')}</span>}
			</p>

			{/* Title */}
			<h1 class="text-3xl md:text-4xl text-balance font-display font-bold mb-4">{props.title}</h1>

			{/* Summary or description */}
			{props.summary && <p class="text-lg md:text-xl text-base-content/90 mb-4 max-w-2xl">{props.summary}</p>}
			{!props.summary && props.description && <p class="text-lg md:text-xl text-base-content/90 mb-4 max-w-2xl">{props.description}</p>}

			{/* Authors / venue */}
			{props.authors && <p class="text-neutral-content text-sm mt-4">{props.authors}</p>}
			{props.venue && <p class="font-bold text-sm mt-1">{props.venue}</p>}
		</div>


		{/* Content */}
		<div class="prose prose-js font-body mb-10 prose-img:mx-auto prose-p:text-justify prose-p:hyphens-auto w-full">
			<slot />
		</div>

		{/* Call-to-action buttons */}
		{props.cta && (
			<div class="flex flex-wrap gap-2 mb-3">
				{props.cta.map((item: { url: string; label: string }, i: number) => (
					<a href={item.url} target={item.url.startsWith("http") ? "_blank" : "_self"} rel="noopener" class:list={[i === 0 ? "btn-solid" : "btn-outline"]}>
						{item.label}&nbsp;↗
					</a>
				))}
			</div>
		)}

		{/* Gallery */}
		{props.gallery && props.gallery.length > 0 && (
			<div class="mb-10">
				<Gallery items={props.gallery} label="Gallery" />
			</div>
		)}
	</main>
</Base>
			
