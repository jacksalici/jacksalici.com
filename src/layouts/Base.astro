---
import '@fontsource-variable/space-grotesk';
import '@fontsource/space-mono';
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import { Pizza, Heart, Earth } from '@lucide/astro';


import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Search from "../components/Search.astro";
const { ...props } = Astro.props;
const today = new Date();
const pathname = new URL(Astro.request.url).pathname;

// Pagefind indexes only what is inside `data-pagefind-body`, so the header and
// the footer stay out of every result. Pages hidden from crawlers stay out too.
const indexable = props.noindex !== true && pathname !== "/404";


---

<html lang="en" transition:animate="none">

  <head>
    <BaseHead title={props.title}
    description={props.description ?? props.summary}
    image={props.image ?? props.cover}
    keywords={props.keywords ?? props.tags ?? props.categories}
    type={props.pageType ?? (props.pubDate ? "article" : "website")}
    publishedTime={props.pubDate}
    modifiedTime={props.updatedDate}
    authors={props.authors}
    noindex={props.noindex ?? pathname === "/404"} />

      <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <ClientRouter />

  </head>

  <body
    class="m-0 text-base-content/85 font-body bg-base-100 flex flex-col gap-4 lg:gap-10 min-h-screen" transition:animate="fade"
  >
    {props.hideHeader !== true && <Header />}
    <Search />
    <div class="contents" data-pagefind-body={indexable ? true : undefined}>
      <slot/>
    </div>
    {props.hideFooter !== true && 
    <footer class="mt-auto p-4 text-neutral group select-none">
      <p class="md:text-center mb-1 text-xs *:inline flex items-center justify-center gap-1">
        2013 - {today.getFullYear()} &copy; Giacomo Salici. Digital craftsman, creative AI engineer. <nobr>Made with <Heart class="inline w-4 h-4 mb-1" /> and <Pizza class="inline w-4 h-4 mb-1" /> on <Earth class="inline w-4 h-4 mb-1" />.</nobr>
      </p>
    </footer>
    }

  <script async defer src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade" /></noscript>
  </body>
</html>
