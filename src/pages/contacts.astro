---
import List from "../components/List.astro";
import ListItem from "../components/ListItem.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";

// Addresses are written as patterns to keep them away from scrapers.
const contacts = [
  { title: "Academic contacts", address: "name.surname@unimore.it" },
  { title: "Other projects", address: "name@thisdomain.com" },
  { title: "Personal stuff", address: "name.surname@the-gmail-mail" },
  { title: "Certified Mail (PEC)", address: "name.surname@ingpec.eu" },
  { title: "Social & Chats", address: "@jacksalici", note: "everywhere as" },
];
---

<Base
  title="Contacts"
  description="Contact Giacomo Salici for research collaborations, projects, and personal inquiries."
  image="/website.jpg"
>
  <main>
    <PageHeader
      crumb="Contacts"
      title="Let's talk!"
      lead="I'd love to hear from you! Whether it's about a project, an idea, or just to say hi, feel free to reach out."
    />

    <List>
      {contacts.map((contact) => (
        <ListItem title={contact.title}>
          <Fragment slot="trail">{contact.note && `${contact.note} `}<code class="text-base-content">{contact.address}</code></Fragment>
        </ListItem>
      ))}
    </List>

    <p class="mt-12 text-sm text-neutral-content">Looking forward to connecting with you!</p>
  </main>
</Base>
