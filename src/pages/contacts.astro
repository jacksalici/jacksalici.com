---
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";

// Addresses are written as patterns to keep them away from scrapers.
const contacts = [
  { title: "Academic contacts", address: "giacomo DOT salici AT unimore DOT it" },
  { title: "Other projects", address: "giacomo AT jacksalici DOT com" },
  { title: "Personal stuff", address: "giacomo DOT salici AT gmail DOT com" },
  { title: "Certified Mail (PEC)", address: "giacomo DOT salici AT ingpec DOT eu" },
  { title: "Social & Chats", address: "@jacksalici", note: "everywhere as" },
];
---

<Base
  title="Contacts"
  description="Contact Giacomo Salici for research collaborations, projects, and personal inquiries."
  image="/website.jpg"
>
  <main>
    <PageHeader
      crumb="Contacts"
      title="Let's talk!"
      lead="I'd love to hear from you! Whether it's about a project, an idea, or just to say hi, feel free to reach out."
    />

    <ul class="list-disc space-y-4 pl-5 marker:text-neutral-content">
      {contacts.map((contact) => (
        <li>
          <span class="font-semibold text-base-content">{contact.title}</span>
          <div class="mt-0.5 text-sm text-neutral-content">
            {contact.note && `${contact.note} `}<code class="text-base-content select-all">{contact.address}</code>
          </div>
        </li>
      ))}
    </ul>

  </main>
</Base>
