---
import { getCollection } from "astro:content";
import Button from "../components/Button.astro";
import Grid from "../components/Grid.astro";
import Icon from "../components/Icon.astro";
import GridItem from "../components/GridItem.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import Base from "../layouts/Base.astro";

interface App {
  title: string;
  tagline?: string;
  emoji: string;
  /** Where the app runs; the fact generator opens a dialog instead. */
  href?: string;
  modal?: boolean;
  /** Write-up of the app. */
  how?: string;
  howLabel: string;
  pubDate?: Date;
  /** When set, the app is retired. */
  dead?: Date;
}

const apps: App[] = (await getCollection("projects"))
  .filter((p) => p.data.draft !== true && p.data.playground)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => {
    const play = p.data.playground;
    const page = `/projects/${p.id}/`;
    return {
      title: play?.title ?? p.data.title ?? p.id,
      tagline: play?.tagline ?? p.data.description,
      emoji: play?.emoji ?? "🎲",
      href: play?.link ?? page,
      how: play?.how ?? (p.data.hidden ? undefined : page),
      howLabel: play?.howLabel ?? (play?.dead ? "How it worked" : "How it works"),
      pubDate: p.data.pubDate,
      dead: play?.dead,
    };
  });

// The fact generator has no project page: it plays inside a dialog on this page.
const randomFact: App = {
  title: "Random Fact Generator",
  tagline: "One unverified truth per reload. Refresh until you find one worth repeating.",
  emoji: "🃏",
  modal: true,
  howLabel: "How it works",
};

const retired = apps.filter((a) => a.dead).sort((a, b) => b.dead!.valueOf() - a.dead!.valueOf());

// One grid: live apps first, retired ones at the end, marked by a tomb.
const grid = [...apps.filter((a) => !a.dead), randomFact, ...retired];

/** "2019–2022" for a retired app, a single year when both coincide. */
const lifespan = (app: App) =>
  app.dead && app.pubDate
    ? [...new Set([app.pubDate.getFullYear(), app.dead.getFullYear()])].join("–")
    : undefined;
---

<Base
  title="Apps"
  description="Small apps, toys, and experiments by Giacomo Salici."
>
  <main>
    <PageHeader
      crumb="Apps"
      title="Small apps, toys, and experiments."
      lead="Stuff built for the pleasure of building them: no sign-up, no purpose, no roadmap. Open one, poke at it, close the tab. No continuity guarantee. Other small diversions are quietly taking shape in the workshop. They will land here as soon as they stop crashing.
"
    />

    <Section>
      <Grid>
        {grid.map((app) => (
          <GridItem title={app.title} description={app.dead ? `[Retired] ${app.tagline ?? ""}`.trim() : app.tagline} emoji={app.dead ? "🪦" : app.emoji} meta={lifespan(app)} muted={!!app.dead}>
            {!app.dead && app.modal && (
              <Button variant="link" class="stretched" data-fact-open data-haptic-press="light">Draw a fact <Icon name="arrow-up-right" size={16} /></Button>
            )}
            {!app.dead && !app.modal && app.href && (
              <Button variant="link" class="stretched" href={app.href} data-haptic-press="light">Play <Icon name="arrow-up-right" size={16} /></Button>
            )}
            {app.how && <Button variant="link" href={app.how}>{app.howLabel}</Button>}
          </GridItem>
        ))}
      </Grid>
    </Section>


    <!-- The fact generator has no page of its own: it plays inside this dialog. -->
    <dialog id="fact-dialog" class="dialog" aria-label="Random fact">
      <div class="flex items-center justify-between gap-4 mb-4">
        <p class="eyebrow">Random fact</p>
        <Button variant="icon" class="-m-2" data-fact-close aria-label="Close" data-haptic-press="light">
          <Icon name="xmark" />
        </Button>
      </div>

      <p id="fact-text" class="page-title min-h-16">
        Shuffling the deck...
      </p>

      <div class="flex items-center justify-between gap-4 mt-6">
        <p class="eyebrow max-w-xs">
          Served by a public API, so treat it as a rumour worth fact-checking.
        </p>
        <Button variant="outline" class="shrink-0" data-fact-more data-haptic-press="medium">
          <Icon name="refresh-double" size={16} />
          Another one
        </Button>
      </div>
    </dialog>
  </main>
</Base>

<script>
  import { play } from "../utils/sounds";

  // DON'T USE EXPOSED API KEY! This is for testing purposes only.
  // Do not use the following key for your project.
  const API_KEY = "8Idmhms+nG6e6Agy9f1jQA==gfaW91jpy9ty2nGz";

  function setupFacts() {
    const dialog = document.getElementById("fact-dialog") as HTMLDialogElement | null;
    const text = document.getElementById("fact-text");
    if (!dialog || !text || dialog.dataset.bound) return;
    dialog.dataset.bound = "true";

    async function draw() {
      text!.textContent = "Shuffling the deck...";
      play("loading");
      try {
        const res = await fetch("https://api.api-ninjas.com/v1/facts", {
          headers: { "X-Api-Key": API_KEY },
        });
        const data = await res.json();
        text!.textContent = data[0].fact + ".";
        play("ready");
      } catch (e) {
        text!.textContent = "Ops, an error occurred.";
        play("error");
      }
    }

    document.querySelectorAll("[data-fact-open]").forEach((btn) =>
      btn.addEventListener("click", () => {
        dialog.showModal();
        play("bloom");
        draw();
      })
    );

    dialog.querySelector("[data-fact-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-fact-more]")?.addEventListener("click", draw);

    // Clicking the backdrop, i.e. outside the dialog's own box, closes it.
    dialog.addEventListener("click", (event) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) dialog.close();
    });
  }

  // `astro:page-load` can fire before this module runs on the first load, so
  // bind right away too; the `bound` flag keeps each dialog to one binding.
  setupFacts();
  document.addEventListener("astro:page-load", setupFacts);
</script>
