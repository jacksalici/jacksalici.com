---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { imageUrl, isOptimizable, resolveImage } from "../utils/images";
import { ArrowUpRight, RefreshCw, X } from "@lucide/astro";
import Base from "../layouts/Base.astro";

const toys = (await getCollection("projects"))
  .filter((p) => p.data.draft !== true && p.data.playground)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => {
    const play = p.data.playground;
    const page = `/projects/${p.id}/`;
    return {
      title: p.data.title,
      tagline: play?.tagline ?? p.data.description,
      emoji: play?.emoji ?? "🎲",
      icon: resolveImage(play?.icon),
      cover: resolveImage(p.data.cover),
      href: play?.link ?? page,
      how: play?.how ?? (p.data.hidden ? undefined : page),
      howLabel: play?.howLabel ?? (play?.dead ? "How it worked" : "How it works"),
      modal: false,
      pubDate: new Date(p.data.pubDate),
      dead: play?.dead ? new Date(play.dead) : undefined,
    };
  });

const livingToys = toys.filter((t) => !t.dead);
const deadToys = toys.filter((t) => t.dead).sort((a, b) => b.dead!.valueOf() - a.dead!.valueOf());

type Card = (typeof toys)[number];

const randomFactCard: Card = {
  title: "Random Fact Generator",
  tagline: "One unverified truth per reload. Refresh until you find one worth repeating.",
  emoji: "🃏",
  icon: undefined,
  cover: resolveImage("/uploads/sky.jpg"),
  href: undefined,
  how: undefined,
  howLabel: "How it works",
  modal: true,
  pubDate: undefined,
  dead: undefined,
};

const nextCuriosityCard: Card = {
  title: "Next curiosity",
  tagline: "Other small diversions are quietly taking shape in the workshop. They will land here as soon as they stop crashing.",
  emoji: "🎲",
  icon: undefined,
  cover: undefined,
  href: undefined,
  how: undefined,
  howLabel: "How it works",
  modal: false,
  pubDate: undefined,
  dead: undefined,
};

const cards = [...livingToys, randomFactCard, nextCuriosityCard, ...deadToys];
---

<Base
  title="Playground"
  description="Experiments, small toys, and half-finished ideas by Giacomo Salici."
>
  <main>
    <p class="eyebrow mb-3 text-accent-4!">Playground</p>
    <h1 class="text-3xl md:text-4xl font-display font-bold mb-4 text-balance">
      A drawer of <span class="italic text-accent-4">things that play back</span>.
    </h1>
    <p class="max-w-2xl text-neutral-content mb-8">
      Small toys built for the pleasure of building them: no sign-up, no purpose, no
      roadmap. Open one, poke at it, close the tab. No continuity guarantee.
    </p>

    {deadToys.length > 0 && (
      <div class="flex justify-end mb-4">
        <button type="button" id="graveyard-toggle" data-expanded="true" class="toggle-btn" data-cuelume-toggle data-haptic-toggle="selection">
          <span class="toggle-label">Show only active toys</span>
        </button>
      </div>
    )}

    <div class="grid gap-4 sm:grid-cols-2">
      {cards.map((card) => {
        const clickable = !card.dead && (card.modal || !!card.href);
        const Tag = card.modal ? "button" : clickable ? "a" : "div";
        const imageClass = [
          "w-full h-full object-cover rounded-none transform-gpu transition-[transform,filter] duration-700! ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none",
          clickable ? "group-hover:blur-md" : "opacity-20",
        ].join(" ");
        return (
        <div
          class:list={[
            "group relative rounded-2xl p-5 flex flex-col gap-3 border transition duration-500 delay-100 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none",
            card.dead
              ? "grayscale border-dashed border-base-300"
              : clickable
                ? "bg-surface hover:bg-linear-0 hover:from-accent-4 hover:to-surface hover:to-40% hover:shadow-2xl border-neutral hover:border-accent-4"
                : "border-dashed border-base-300 text-neutral-content",
          ]}
          data-dead={card.dead ? "" : undefined}
          data-graveyard-item={card.dead || card === nextCuriosityCard ? "" : undefined}
        >
            <div class="relative -m-1 mb-0 rounded-xl rounded-bl-none overflow-hidden aspect-3/1">
              {card.cover && (
                !isOptimizable(card.cover) ? (
                  <img
                    src={imageUrl(card.cover)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class={imageClass}
                  />
                ) : (
                  <Image
                    src={card.cover}
                    alt=""
                    width={760}
                    densities={[1, 2]}
                    loading="lazy"
                    decoding="async"
                    class={imageClass}
                  />
                )
              )}

              {card.dead && card.pubDate && (
                <span class="absolute top-2 right-2 z-30 rounded-full bg-base-content text-base-100 px-2.5 py-1 text-xs shadow-lg">
                  {card.pubDate.getFullYear()}-{card.dead.getFullYear()}
                </span>
              )}

              <span class:list={[
                "absolute left-0 bottom-0 grid place-items-center w-1/4 aspect-square rounded-tr-2xl z-30",
                clickable && " bg-surface border-2 border-surface",
                !clickable && "bg-base-100"
              ]}>
                {card.icon ? (
                  <img
                    src={imageUrl(card.icon)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="w-9/12 object-contain rounded-none"
                  />
                ) : (
                  <span class="text-5xl leading-none">{card.emoji}</span>
                )}
              </span>
            </div>
          <div>
            <h3 class:list={["text-xl text-base-content transition-colors", clickable && "group-hover:text-accent-4"]}>
              {card.title}
            </h3>
            {card.tagline && (
              <p class:list={["text-neutral-content mt-1", clickable && "group-hover:text-accent-4"]}>
                {card.tagline}
              </p>
            )}
          </div>

            <div class="mt-auto pt-2 flex items-end justify-between gap-3">
              {clickable && (
                <Tag
                  href={card.href}
                  target={card.href?.startsWith("http") ? "_blank" : undefined}
                  rel={card.href?.startsWith("http") ? "noopener" : undefined}
                  data-fact-open={card.modal ? "" : undefined}
                  class="text-xs font-mono text-neutral-content inline-flex items-center gap-1 cursor-pointer transition-colors group-hover:text-white before:absolute before:inset-0 before:rounded-2xl before:content-['']"
                  data-cuelume-hover="sparkle"
                  data-cuelume-press
                  data-haptic-press="light"
                >
                  Explore
                  <ArrowUpRight class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </Tag>
              )}
              {card.how && (
                <a
                  href={card.how}
                  class:list={[
                    "ml-auto relative z-10 text-xs text-neutral-content/80 underline decoration-dotted underline-offset-4 transition-all hover:opacity-70",
                    clickable && "group-hover:text-white/50"
                  ]}
                >
                  {card.howLabel}
                </a>
              )}
            </div>
        </div>
        );
      })}
    </div>

    <!-- The fact generator has no page of its own: it plays inside this dialog. -->
    <dialog id="fact-dialog" class="search-dialog" aria-label="Random fact">
      <div class="flex items-start justify-between gap-4 mb-4">
        <p class="eyebrow">Random fact</p>
        <button data-fact-close class="icon-btn -m-2" aria-label="Close" data-haptic-press="light">
          <X class="w-4 h-4" />
        </button>
      </div>

      <p id="fact-text" class="font-display text-xl md:text-2xl text-balance min-h-[4rem]">
        Shuffling the deck...
      </p>

      <div class="flex items-center justify-between gap-4 mt-6">
        <p class="text-xs text-neutral-content max-w-xs">
          Served by a public API, so treat it as a rumour worth fact-checking.
        </p>
        <button data-fact-more class="btn-outline shrink-0 cursor-pointer" data-cuelume-hover="tick"  data-cuelume-press="bloom" data-haptic-press="medium">
          <RefreshCw class="w-4 h-4" />
          Another one
        </button>
      </div>
    </dialog>
  </main>
</Base>

<script>
  import { play } from "../utils/sounds";

  // DON'T USE EXPOSED API KEY! This is for testing purposes only.
  // Do not use the following key for your project.
  const API_KEY = "8Idmhms+nG6e6Agy9f1jQA==gfaW91jpy9ty2nGz";

  function setupFacts() {
    const dialog = document.getElementById("fact-dialog") as HTMLDialogElement | null;
    const text = document.getElementById("fact-text");
    if (!dialog || !text) return;

    async function draw() {
      text!.textContent = "Shuffling the deck...";
      play("loading");
      try {
        const res = await fetch("https://api.api-ninjas.com/v1/facts", {
          headers: { "X-Api-Key": API_KEY },
        });
        const data = await res.json();
        text!.textContent = data[0].fact + ".";
        play("ready");
      } catch (e) {
        text!.textContent = "Ops, an error occurred.";
        play("error");
      }
    }

    document.querySelectorAll("[data-fact-open]").forEach((btn) =>
      btn.addEventListener("click", () => {
        dialog.showModal();
        play("bloom");
        draw();
      })
    );

    dialog.querySelector("[data-fact-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-fact-more]")?.addEventListener("click", draw);

    // Clicking the backdrop, i.e. outside the dialog's own box, closes it.
    dialog.addEventListener("click", (event) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) dialog.close();
    });
  }

  // Retired toys and the "Next curiosity" placeholder are shown by default;
  // this toggles both away together.
  function setupGraveyard() {
    const btn = document.getElementById("graveyard-toggle") as HTMLButtonElement | null;
    if (!btn) return;

    const label = btn.querySelector(".toggle-label");
    const graveyardItems = document.querySelectorAll<HTMLElement>("[data-graveyard-item]");

    btn.addEventListener("click", () => {
      const expanded = btn.dataset.expanded !== "false";
      const nextExpanded = !expanded;
      graveyardItems.forEach((card) => (card.hidden = !nextExpanded));
      btn.dataset.expanded = String(nextExpanded);
      if (label) label.textContent = nextExpanded ? "Show only active toys" : "Show all toys";
    });
  }

  // Also fires on the first load, and again after every ClientRouter swap.
  document.addEventListener("astro:page-load", setupFacts);
  document.addEventListener("astro:page-load", setupGraveyard);
</script>
