---
import { getCollection } from "astro:content";
import List from "../components/List.astro";
import ListItem from "../components/ListItem.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import Base from "../layouts/Base.astro";
import { getActivities } from "../utils/news";

const papers = (await getCollection("papers", (p) => p.data.draft !== true && p.data.hidden !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// A research activity is one with at least one paper behind it.
const activities = (await getActivities())
  .filter((a) => a.data.hidden !== true)
  .map((activity) => ({
    activity,
    papers: papers.filter((p) => p.data.activities?.includes(activity.id)).length,
  }))
  .filter((entry) => entry.papers > 0);
---

<Base
  title="Research"
  description="Research activities and peer-reviewed papers by Giacomo Salici, PhD candidate at AImageLab, University of Modena and Reggio Emilia."
  keywords={["giacomo salici", "research", "papers", "publications", "aimagelab"]}
>
  <main>
    <PageHeader eyebrow="Research" title="Research activities and papers.">
      <p>
        I am a PhD candidate in ICT with the <a href="https://aimagelab.unimore.it/">AImageLab&nbsp;↗</a> research group of the University of Modena and Reggio Emilia. These are the lines of research I work on and the papers that came out of them.
      </p>
    </PageHeader>

    <Section title="Activities" id="activities">
      <List>
        {activities.map(({ activity, papers }) => (
          <ListItem
            href={"/activities/" + activity.id}
            title={activity.data.title ?? activity.id}
            description={activity.data.description}
            trail={`${papers} paper${papers === 1 ? "" : "s"}`}
          />
        ))}
      </List>
    </Section>

    <Section title="Papers" id="papers">
      <List>
        {papers.map((paper) => (
          <ListItem
            href={"/papers/" + paper.id}
            title={paper.data.title ?? paper.id}
            description={paper.data.authors}
            date={paper.data.pubDate}
            chip={paper.data.acronym ?? paper.data.venue}
          />
        ))}
      </List>
    </Section>
  </main>
</Base>
