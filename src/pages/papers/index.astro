---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import EntryRow from "../../components/EntryRow.astro";

const papers = (await getCollection("papers"))
  .filter((a) => a.data.draft !== true && a.data.hidden !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="Papers"
  description="Peer-reviewed papers and publications by Giacomo Salici."
  image="/website.jpg"
>
  <main>
    <p class="eyebrow mb-3">Publications</p>
    <h1 class="mb-8 text-3xl md:text-4xl font-display font-bold">Papers</h1>

    <EntryList>
      {
        papers.map((paper) => (
          <EntryRow
            href={"/papers/" + paper.id}
            title={paper.data.title ?? paper.id}
            meta={paper.data.acronym}
            date={paper.data.pubDate}
          />
        ))
      }
    </EntryList>
  </main>
</Base>
