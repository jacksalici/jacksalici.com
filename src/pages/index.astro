---
import { getCollection } from "astro:content";
import { FileText, Boxes, PenLine, ArrowRight } from "@lucide/astro";
import FormattedDate from "../components/FormattedDate.astro";
import Base from "../layouts/Base.astro";
import "../styles/global.css";

// Ordered by the `order` field in each activity's frontmatter, ascending.
const activities = (await getCollection("activities"))
  .filter((a) => a.data.draft !== true && a.data.hidden !== true && a.data.shown !== false)
  .sort((a, b) => a.data.order - b.data.order);

const papers = (await getCollection("papers")).filter(
  (a) => a.data.draft !== true && a.data.hidden !== true
);

const projects = (await getCollection("projects")).filter(
  (a) => a.data.draft !== true && a.data.hidden !== true
);

const notes = (await getCollection("notes")).filter(
  (a) => a.data.draft !== true && a.data.hidden !== true
);

// Accent gradient painted on the front of each activity card. 
const activityGradients: Record<string, string> = {
  "applied-embodied-ai": "from-accent-2 to-primary",
  "modular-deep-learning": "from-accent-4 to-primary",
  "anomaly-detection-tsa": "from-accent-1 to-primary",
  "coding-web-apps": "from-accent-3 to-primary",
};
const defaultGradient = "from-neutral to-neutral-content";

const pileByActivity: Record<string, (string | null)[]> = {};
for (const activity of activities) {
  const covers = [...projects, ...papers]
    .filter((item) => item.data.activities?.includes(activity.id) && item.data.cover)
    .map((item) => item.data.cover as string)
    .slice(0, 3);
  pileByActivity[activity.id] = covers.length >= 2 ? covers : [...covers, null, null].slice(0, 3);
}

const latestPapers = papers
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latestProjects = projects
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latestNotes = notes
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const props = { image: "/sky.png" };
---

<Base
  title="Digital craftsman, creative AI engineer"
  description="Giacomo Salici is a computer and AI engineer in Italy building research projects, notes, papers, and digital products."
  image={props.image}
  keywords={["giacomo salici", "ai engineer", "computer engineer", "robotics", "research", "portfolio"]}
>
  <main>
    <section class="pt-6 pb-10 md:pt-10 md:pb-14">
      <h1 class="text-3xl md:text-4xl text-balance font-display font-bold leading-tight">
        A digital craftsman who designs <span class="italic">systems that matter</span>.
      </h1>

      <div class="mt-6 flex flex-col gap-4 max-w-2xl">
        <p>
          I am <span class="font-bold">Giacomo Salici</span>, an <span class="">AI &amp; computer engineer, developer, and occasionally designer</span> based in Italy. I work with the <a class="font-bold" href="https://aimagelab.unimore.it/">AImageLab&nbsp;↗</a> research group of University of Modena and Reggio Emilia (<a href="https://www.unimore.it/">UniMORE&nbsp;↗</a>) as a <span class="font-bold">PhD candidate in ICT</span>.
        </p>
        <p>
          My research interests include artificial intelligence of things (AIoT), modular deep learning, and anomaly detection. Besides research, I enjoy open-source software and hardware, good design, 3D printing, the outdoors, swimming, DnD, pizza, and desk plants.
        </p>
      </div>

      <div class="mt-6 flex flex-wrap gap-2 text-sm">
        <a href="/contacts" class="btn-solid">Get in touch&nbsp;↗</a>
        <a href="https://github.com/jacksalici" class="btn-outline">GitHub&nbsp;↗</a>
        <a href="https://scholar.google.com/citations?user=jMVa-rYAAAAJ" class="btn-outline">Google Scholar&nbsp;↗</a>
        <a href="https://linkedin.com/in/jacksalici" class="btn-outline">LinkedIn&nbsp;↗</a>
      </div>
    </section>

    <section class="mb-20">
      <p class="section-label">Current Activities</p>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-3 lg:-mx-32">
        {activities.map((activity) => {
          const gradient = activityGradients[activity.id] ?? defaultGradient;
          return (
            <a href={"/activities/" + activity.id} class="activity-card group relative block aspect-square">
              <div class="pile absolute inset-0 pointer-events-none">
                {pileByActivity[activity.id].map((src) => (
                  <div class="pile-sheet absolute inset-0 rounded-xl overflow-hidden bg-base-100 border border-base-200">
                    {src && <img src={src} alt="" loading="lazy" class="w-full h-full object-cover" />}
                  </div>
                ))}
              </div>

              <div class={`face absolute inset-0 rounded-xl overflow-hidden backdrop-blur-sm bg-gradient-to-br ${gradient}`}>
                {/* Keeps the title legible on the lighter warm gradients. */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                <div class="relative h-full flex items-end p-4">
                  <h2 class="font-display text-lg text-base-100 text-balance">
                    {activity.data.title}
                  </h2>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <style>
        .activity-card:hover,
        .activity-card:focus-visible {
          z-index: 20;
        }
        .activity-card .face {
          z-index: 10;
        }
        .activity-card .pile-sheet {
          transform-origin: top left;
          transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
          box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }
        .activity-card .pile-sheet:nth-child(1) {
          transform: rotate(-1deg);
        }
        .activity-card .pile-sheet:nth-child(2) {
          transform: rotate(-2deg);
        }
        .activity-card .pile-sheet:nth-child(3) {
          transform: rotate(-3deg);
        }
        .activity-card:hover .pile-sheet,
        .activity-card:focus-visible .pile-sheet {
          box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.25);
        }
        .activity-card:hover .pile-sheet:nth-child(1),
        .activity-card:focus-visible .pile-sheet:nth-child(1) {
          transform: rotate(-3deg);
        }
        .activity-card:hover .pile-sheet:nth-child(2),
        .activity-card:focus-visible .pile-sheet:nth-child(2) {
          transform: rotate(-6deg);
        }
        .activity-card:hover .pile-sheet:nth-child(3),
        .activity-card:focus-visible .pile-sheet:nth-child(3) {
          transform: rotate(-9deg);
        }
        @media (prefers-reduced-motion: reduce) {
          .activity-card .pile-sheet {
            transition: none;
          }
        }
      </style>

      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-12">
        <a href="/activities" class="text-sm inline-flex items-center gap-1.5 text-neutral-content hover:text-accent-1 transition-colors">
          All activities <ArrowRight size={14} />
        </a>
        <a href="/projects" class="text-sm inline-flex items-center gap-1.5 text-neutral-content hover:text-accent-1 transition-colors">
          All projects <ArrowRight size={14} />
        </a>
      </div>
    </section>

    <section class="mb-20">
      <p class="section-label">Latest papers</p>

      <ul class="flex flex-col gap-1 mb-4">
        {latestPapers.map((paper) => (
          <li>
            <a href={"/papers/" + paper.id} class="group flex items-start gap-3 py-2 hover:text-accent-1 transition-colors">
              <FileText size={14} class="shrink-0 mt-1 text-neutral-content group-hover:text-accent-1 transition-colors" />
              <span class="min-w-0 flex-1">{paper.data.news}</span>
              <span class="shrink-0 text-xs text-neutral-content">
                {paper.data.acronym && <span class="font-bold mr-2">{paper.data.acronym}</span>}
                <FormattedDate date={paper.data.pubDate} />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <a href="/papers" class="text-sm inline-flex items-center gap-1.5 text-neutral-content hover:text-accent-1 transition-colors">
        All papers <ArrowRight size={14} />
      </a>
    </section>

    <section class="mb-20">
      <p class="section-label">Latest projects</p>

      <ul class="flex flex-col gap-1 mb-4">
        {latestProjects.map((project) => (
          <li>
            <a href={"/projects/" + project.id} class="group flex items-start gap-3 py-2 hover:text-accent-1 transition-colors">
              <Boxes size={14} class="shrink-0 mt-1 text-neutral-content group-hover:text-accent-1 transition-colors" />
              <span class="min-w-0 flex-1">{project.data.news}</span>
              <span class="shrink-0 text-xs text-neutral-content">
                <FormattedDate date={project.data.pubDate} />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <a href="/projects" class="text-sm inline-flex items-center gap-1.5 text-neutral-content hover:text-accent-1 transition-colors">
        All projects <ArrowRight size={14} />
      </a>
    </section>

    {latestNotes.length > 0 && (
      <section class="mb-16">
        <p class="section-label">Latest thoughts</p>

        <ul class="flex flex-col gap-1">
          {latestNotes.map((note) => (
            <li>
              <a href={"/notes/" + note.id} class="group flex items-start gap-3 py-2 hover:text-accent-1 transition-colors">
                <PenLine size={14} class="shrink-0 mt-1 text-neutral-content group-hover:text-accent-1 transition-colors" />
                <span class="min-w-0 flex-1">{note.data.title}</span>
                <span class="shrink-0 text-xs text-neutral-content">
                  <FormattedDate date={note.data.pubDate} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>
