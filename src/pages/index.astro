---
import { Image } from "astro:assets";
import portrait from "../assets/uploads/newphoto.jpg";
import EntryList from "../components/EntryList.astro";
import EntryRow from "../components/EntryRow.astro";
import Base from "../layouts/Base.astro";
import { getActivities, getNews } from "../utils/news";
import "../styles/global.css";

const news = await getNews();
const activities = (await getActivities()).filter((a) => a.data.hidden !== true && a.data.shown !== false);

// Only the first INITIAL_VISIBLE rows show until "Show all" is clicked.
const INITIAL_VISIBLE = 6;

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;

// How much work sits behind each activity, shown next to its title.
function tally(activityId: string) {
  const related = news.filter((item) => item.activities?.includes(activityId));
  const papers = related.filter((item) => item.collection === "papers").length;
  const projects = related.filter((item) => item.collection === "projects").length;
  return [projects && plural(projects, "project"), papers && plural(papers, "paper")]
    .filter(Boolean)
    .join(" · ");
}

const props = { image: "/uploads/sky.jpg" };
---

<Base
  title="Digital craftsman, creative AI engineer"
  description="Giacomo Salici is a computer and AI engineer in Italy building research projects, notes, papers, and digital products."
  image={props.image}
  keywords={["giacomo salici", "ai engineer", "computer engineer", "robotics", "research", "portfolio"]}
>
  <main>
    <section id="about">
      <Image src={portrait} alt="Giacomo Salici at ICCV 2025, Honolulu" width={64} height={64} densities={[1, 2, 3]} class="avatar" data-cuelume-hover="tick" />

      <h1 class="mt-6 text-3xl md:text-4xl text-balance tracking-tight leading-[1.1] max-w-2xl">
        A digital craftsman who designs systems that matter.
      </h1>

      <div class="mt-5 max-w-2xl">
        <p class="sm:text-lg leading-relaxed text-neutral-content">
          I am <span class="font-medium text-base-content">Giacomo Salici</span>, an AI &amp; computer engineer, developer, and occasionally designer based in Italy. I work with the <a class="font-medium text-base-content" href="https://aimagelab.unimore.it/">AImageLab&nbsp;↗</a> research group of UniMORE as a <span class="font-medium text-base-content">PhD candidate in ICT</span>.{" "}
          <button type="button" class="read-toggle toggle-btn align-middle" aria-expanded="false" aria-controls="bio-more" data-cuelume-toggle>Read more ↘</button>
        </p>

        <div id="bio-more" data-open="false" class="read-panel">
          <div>
            <p class="text-neutral-content leading-relaxed pt-4">
              At <a href="https://www.unimore.it/">University of Modena and Reggio Emilia&nbsp;↗</a>, my research interests include <span class="font-medium text-base-content">artificial intelligence of things (AIoT)</span>, <span class="font-medium text-base-content">modular deep learning</span>, and <span class="font-medium text-base-content">anomaly detection</span>. Besides my research work, I also enjoy (in casual order): <span class="font-medium text-base-content">open-source software and hardware</span>, good designs (digital and physical), to craft random stuff, 3D printing, the outdoors, swimming, DnD, pizza, and desk plants.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-16" id="activities">
      <p class="section-label">What I am doing right now</p>

      <ul class="flex flex-col">
        {activities.map((activity) => (
          <li>
            <a
              href={"/activities/" + activity.id}
              data-activity-id={activity.id}
              class="list-row list-row--baseline"
              data-cuelume-hover="tick"
              data-cuelume-press
              data-haptic-press="light"
            >
              <span class="min-w-0 flex-1">{activity.data.title}</span>
              <span class="hidden sm:block shrink-0 text-xs tabular-nums text-neutral-content">{tally(activity.id)}</span>
              <span class="shrink-0 text-neutral-content" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16" id="news" data-pagefind-ignore>
      <p class="section-label">Latest news</p>

      <EntryList id="news-list" class="mb-5">
        {news.map((item, i) => (
          <EntryRow
            href={item.href}
            title={item.title}
            date={item.date}
            kind={item.kind}
            hidden={i >= INITIAL_VISIBLE}
          />
        ))}
      </EntryList>

      {news.length > INITIAL_VISIBLE && (
        <button type="button" data-expanded="false" class="toggle-btn list-toggle" data-target="news-list" data-cuelume-toggle>
          <span class="toggle-label">Show all ↘</span>
        </button>
      )}
    </section>

    <section class="mt-20 pt-8 border-t border-base-300">
      <p class="section-label">Let's make something that matters</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/contacts" class="nav-link text-base-content!" data-cuelume-hover="tick">Get in touch&nbsp;↗</a>
        <a href="https://github.com/jacksalici" class="nav-link" data-cuelume-hover="tick">GitHub&nbsp;↗</a>
        <a href="https://scholar.google.com/citations?user=jMVa-rYAAAAJ" class="nav-link" data-cuelume-hover="tick">Google Scholar&nbsp;↗</a>
        <a href="https://linkedin.com/in/jacksalici" class="nav-link" data-cuelume-hover="tick">LinkedIn&nbsp;↗</a>
      </div>
    </section>
  </main>
</Base>

<script>
// Re-run on every ClientRouter navigation (including back/forward), not just the
// first load, since that's the only way freshly swapped-in elements get their
// listeners re-attached.
document.addEventListener("astro:page-load", () => {
  const toggle = document.querySelector(".read-toggle");
  const panel = document.getElementById("bio-more");

  function setBio(open: boolean) {
    if (panel) panel.dataset.open = String(open);
    if (!toggle) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "Read less ↖" : "Read more ↘";
  }

  toggle?.addEventListener("click", () => {
    setBio(panel?.dataset.open !== "true");
  });

  // The header's "About" link points at /#about and expects the long bio open.
  function openBioFromHash() {
    if (location.hash === "#about") setBio(true);
  }

  openBioFromHash();
  window.addEventListener("hashchange", openBioFromHash);
  // Clicking it while already at /#about fires no hashchange, so catch the click too.
  document.querySelectorAll('a[href$="#about"]').forEach((link) => {
    link.addEventListener("click", () => setBio(true));
  });

  const INITIAL_VISIBLE = 6;

  // "Show all" / "Show latest" toggle for a list of entries.
  document.querySelectorAll<HTMLButtonElement>(".list-toggle").forEach((btn) => {
    const list = document.getElementById(btn.dataset.target ?? "");
    if (!list) return;
    const label = btn.querySelector(".toggle-label");

    btn.addEventListener("click", () => {
      const expanded = btn.dataset.expanded !== "true";
      list.querySelectorAll<HTMLElement>(".entry").forEach((entry, i) => {
        entry.hidden = !expanded && i >= INITIAL_VISIBLE;
      });
      btn.dataset.expanded = String(expanded);
      if (label) label.textContent = expanded ? "Show latest ↖" : "Show all ↘";
    });
  });

  // Activities used to open in a dialog at /#<activity-id>; send those old
  // links to the activity's own page.
  const legacy = document.querySelector<HTMLAnchorElement>(
    `a[data-activity-id="${CSS.escape(location.hash.slice(1))}"]`
  );
  if (legacy) location.replace(legacy.href);
});
</script>
