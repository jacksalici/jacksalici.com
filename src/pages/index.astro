---
import { Image } from "astro:assets";
import portrait from "../assets/uploads/newphoto.jpg";
import Button from "../components/Button.astro";
import KindFilter from "../components/KindFilter.astro";
import Icon from "../components/Icon.astro";
import List from "../components/List.astro";
import ListItem from "../components/ListItem.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import Base from "../layouts/Base.astro";
import { kindLabels } from "../consts";
import { getNews } from "../utils/news";

const news = await getNews();
// News shown before "All updates" reveals the rest.
const LATEST = 6;

const props = { image: "/uploads/sky.jpg" };
---

<Base
  title="Digital craftsman, creative AI engineer"
  description="Giacomo Salici is a computer and AI engineer in Italy building research projects, notes, papers, and digital products."
  image={props.image}
  keywords={["giacomo salici", "ai engineer", "computer engineer", "robotics", "research", "portfolio"]}
>
  <main>
    <PageHeader size="lg" title="A digital craftsman who designs systems that matter.">
      <span slot="aside" class="avatar">
        <Image src={portrait} alt="Giacomo Salici rowing a boat on a lake in the mountains" width={320} loading="eager" />
      </span>
      <p>
        I am <strong>Giacomo Salici</strong>, an AI &amp; computer engineer, developer, and occasionally designer based in Italy. I work with the <a href="https://aimagelab.unimore.it/">AImageLab</a> research group of UniMORE as a <strong>PhD candidate in ICT</strong>; and collaborate with <a href="https://www.aimagelab.it/">GoatAI</a> as a <strong>project lead</strong> and research consultant.
      </p>
      <p>
        My research interests include <strong>AIoT</strong>, <strong>embodied AI</strong>, <strong>modular DL</strong>, and <strong>anomaly detection</strong>. I also enjoy (in casual order): open-source software and hardware, good designs (digital and physical), to craft random stuff, 3D printing, the outdoors, swimming, DnD, pizza, and desk plants.
      </p>

      <div slot="after" class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <Button variant="link" href="/contacts" class="text-base-content">Get in touch <Icon name="arrow-up-right" size={16} /></Button>
        <Button variant="link" href="https://cv.jacksalici.com/" class="text-base-content">Curriculum vitae <Icon name="arrow-up-right" size={16} /></Button>
        {/* -my-2 keeps the icon buttons' padding from making the row taller than the text link. */}
        <div class="flex items-center gap-1 -my-2">
          <Button variant="icon" href="https://github.com/jacksalici" aria-label="GitHub"><Icon name="github" /></Button>
          <Button variant="icon" href="https://scholar.google.com/citations?user=jMVa-rYAAAAJ" aria-label="Google Scholar"><Icon name="graduation-cap" /></Button>
          <Button variant="icon" href="https://linkedin.com/in/jacksalici" aria-label="LinkedIn"><Icon name="linkedin" /></Button>
        </div>
      </div>
    </PageHeader>

    <Section title="News" id="news" data-pagefind-ignore>
      <KindFilter slot="action" for="news-list" items={news.map((item) => item.kind)} />
      <List id="news-list">
        {news.map((item, i) => (
          <ListItem href={item.href} title={item.title} date={item.date} chip={kindLabels[item.kind]} kind={item.kind} hidden={i >= LATEST} />
        ))}
      </List>

      {news.length > LATEST && (
        <Button variant="link" class="mt-4" data-news-more data-more-for="news-list" data-haptic-press="light">
          All {news.length} updates
          <Icon name="arrow-down" size={16} />
        </Button>
      )}
    </Section>
  </main>
</Base>

<script>
// One delegated listener: module scripts run once and the document outlives
// ClientRouter swaps, so this works on first load and after every navigation.
document.addEventListener("click", (event) => {
  const more = (event.target as Element).closest<HTMLButtonElement>("[data-news-more]");
  if (!more) return;
  document.querySelectorAll<HTMLElement>("#news-list [data-entry][hidden]").forEach((entry) => (entry.hidden = false));
  more.remove();
});
</script>
