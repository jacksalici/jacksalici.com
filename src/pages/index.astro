---
import { getCollection, render } from "astro:content";
import { Bot, Network, Activity, Code, Search as SearchIcon } from "@lucide/astro";
import EntryList from "../components/EntryList.astro";
import EntryRow from "../components/EntryRow.astro";
import Base from "../layouts/Base.astro";
import { categories } from "../consts";
import "../styles/global.css";

// Ordered by the `order` field in each activity's frontmatter, ascending.
const activities = (await getCollection("activities"))
  .filter((a) => a.data.draft !== true && a.data.hidden !== true && a.data.shown !== false)
  .sort((a, b) => a.data.order - b.data.order);

// Compiled body markdown for each activity, shown in its details panel.
const activityContent = Object.fromEntries(
  await Promise.all(activities.map(async (activity) => [activity.id, await render(activity)] as const))
);

const papers = (await getCollection("papers")).filter(
  (a) => a.data.draft !== true && a.data.hidden !== true
);

const projects = (await getCollection("projects")).filter(
  (a) => a.data.draft !== true && a.data.hidden !== true
);

const notes = (await getCollection("notes")).filter(
  (a) => a.data.draft !== true && a.data.hidden !== true
);

// Icon painted on each activity card, representing its area of work.
const activityIcons: Record<string, typeof Bot> = {
  "applied-embodied-ai": Bot,
  "modular-deep-learning": Network,
  "anomaly-detection-tsa": Activity,
  "coding-web-apps": Code,
};

// Desktop layout: two wider cards on top, two narrower ones below.
// Index-based, so it follows `order`.
const activitySpans = ["md:col-span-3", "md:col-span-3", "md:col-span-2", "md:col-span-2"];

// How much work sits behind each activity, shown on its card.
const tallyByActivity: Record<string, { projects: number; papers: number }> = {};
for (const activity of activities) {
  tallyByActivity[activity.id] = {
    projects: projects.filter((p) => p.data.activities?.includes(activity.id)).length,
    papers: papers.filter((p) => p.data.activities?.includes(activity.id)).length,
  };
}

// Sorted newest first; only the first INITIAL_VISIBLE rows show until "Load more" is clicked.
const INITIAL_VISIBLE = 3;

const latestPapers = papers.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestProjects = projects.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestNotes = notes
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const props = { image: "/sky.png" };
---

<Base
  title="Digital craftsman, creative AI engineer"
  description="Giacomo Salici is a computer and AI engineer in Italy building research projects, notes, papers, and digital products."
  image={props.image}
  keywords={["giacomo salici", "ai engineer", "computer engineer", "robotics", "research", "portfolio"]}
>
  <main>
    <section class="relative" id="about">
      <h1 class="text-4xl md:text-5xl text-balance font-display font-bold leading-[1.08] tracking-tight">
        A digital craftsman who designs <span class="italic text-accent-3">systems that matter</span>.
      </h1>

      <div class="mt-7 flex flex-col-reverse sm:flex-row sm:items-start gap-6 sm:gap-8">
        <div class="flex-1 min-w-0">
          <p class="text-lg leading-relaxed">
            I am <span class="font-bold">Giacomo Salici</span>, an AI &amp; computer engineer, developer, and occasionally designer based in Italy. I work with the <a class="font-bold" href="https://aimagelab.unimore.it/">AImageLab&nbsp;↗</a> research group of UniMORE as a <span class="font-bold">PhD candidate in ICT</span>.{" "}
            <button type="button" class="read-toggle toggle-btn align-middle" aria-expanded="false">Read more ↘</button>
          </p>

          <div id="bio-more" data-open="false" class="read-panel">
            <div>
              <p class="text-neutral-content leading-relaxed pt-4">
                At the <a href="https://www.unimore.it/">University of Modena and Reggio Emilia&nbsp;↗</a>, my research interests include <span class="text-accent-2 font-bold"><Bot class:list={"inline pb-1"}/>&nbsp;artificial intelligence of things (AIoT)</span>, <span class="text-accent-2 font-bold"><Network class:list={"inline pb-1"}/>&nbsp;modular deep learning</span>, and <span class="text-accent-2 font-bold"><Activity class:list={"inline pb-1"}/>&nbsp;anomaly detection </span>. Besides my research work, I also enjoy (in casual order): <span class="text-accent-2 font-bold"><Code class:list={"inline pb-1"}/>&nbsp;open-source software and hardware</span>, good designs (digital and physical), to craft random stuff, 3D printing, the outdoors, swimming, DnD, pizza, and desk plants.
              </p>
            </div>
          </div>
        </div>

        <div data-reading="false" class="snapshot shrink-0 self-start mx-auto sm:mx-0">
          <img src="/newphoto.jpg" alt="Giacomo Salici" width="720" height="722" class="w-36 aspect-square object-cover rounded-none" />
          <span class="text-xs">Me @ ICCV25, Honolulu </span>
        </div>
      </div>

      <button type="button" class="search-trigger mt-10" data-search-open data-pagefind-ignore>
        <SearchIcon size={16} stroke-width={1.75} />
        <span>Search everything I have made…</span>
      </button>

      <p class="section-label mt-12"><span class="section-num">01</span>What I am doing right now</p>

      <div
        data-pinned="false"
        class="activity-rail md:mx-0 md:px-0 flex md:grid md:grid-cols-10 lg:-mx-20 gap-5 overflow-x-auto md:overflow-visible snap-x snap-mandatory"
      >
        {activities.map((activity, i) => {
          const tally = tallyByActivity[activity.id];
          const Icon = activityIcons[activity.id];
          return (
            <a
              href={"#" + activity.id}
              data-activity-id={activity.id}
              aria-pressed="false"
              class:list={[
                "activity-card group relative block",
                "w-[70%] h-44 shrink-0",
                "md:w-auto md:shrink md:h-56",
                activitySpans[i],
              ]}
            >
              <div class="face">
                <div class="face-content">
                  {Icon && <Icon class="absolute top-5 left-5 md:top-6 md:left-6 opacity-70" size={22} stroke-width={1.75} />}
                  <p class="text-xs uppercase font-mono mb-2 opacity-70">
                    {activity.data.kicker}
                  </p>
                  <h2 class="font-sans text-lg">
                    {activity.data.title}
                  </h2>
                  <p class="mt-2 text-xs font-mono opacity-70">
                    {[
                      tally.projects && `${tally.projects} project${tally.projects > 1 ? "s" : ""}`,
                      tally.papers && `${tally.papers} paper${tally.papers > 1 ? "s" : ""}`,
                    ]
                      .filter(Boolean)
                      .join("  ·  ")}
                  </p>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <div id="activity-details" data-open="false" class="read-panel">
        <div>
          <div class="pt-6">
            {activities.map((activity) => {
              const { Content } = activityContent[activity.id];
              return (
                <div class="activity-detail" data-activity-id={activity.id} hidden>
                  {activity.data.description && (
                    <p class="text-neutral-content text-xl font-display font-normal text-balance">{activity.data.description}</p>
                  )}
                  <div class="prose prose-js font-body text-neutral-content mt-4 max-w-none">
                    <Content />
                    <span class="mt-8 opacity-50 text-xs">Scroll to see the related projects.</span>
                  </div>
                  
                </div>
              );
            })}
          </div>
        </div>
      </div>

    <section class="mt-20" id="papers" data-pagefind-ignore>
      <p class="section-label"><span class="section-num">02</span>My latest research papers</p>

      <EntryList id="papers-list" class="mb-5">
        {latestPapers.map((paper, i) => (
          <EntryRow
            href={"/papers/" + paper.id}
            title={paper.data.news ?? paper.data.title ?? paper.id}
            meta={paper.data.acronym}
            date={paper.data.pubDate}
            hidden={i >= INITIAL_VISIBLE}
            activities={paper.data.activities}
          />
        ))}
      </EntryList>

      {latestPapers.length > INITIAL_VISIBLE && (
        <button type="button" data-expanded="false" class="toggle-btn">
          <span class="toggle-label">Show all ↘</span>
        </button>
      )}
    </section>

    <section class="mt-20" id="projects" data-pagefind-ignore>
      <p class="section-label"><span class="section-num">03</span>My latest projects</p>

      <EntryList id="projects-list" class="mb-5">
        {latestProjects.map((project, i) => (
          <EntryRow
            href={"/projects/" + project.id}
            title={project.data.news ?? project.data.title ?? project.id}
            meta={
              project.data.categories?.[0]
                ? (categories[project.data.categories[0]] ?? project.data.categories[0])
                : undefined
            }
            date={project.data.pubDate}
            hidden={i >= INITIAL_VISIBLE}
            activities={project.data.activities}
          />
        ))}
      </EntryList>

      {latestProjects.length > INITIAL_VISIBLE && (
        <button type="button" data-expanded="false" class="toggle-btn">
          <span class="toggle-label">Show all ↘</span>
        </button>
      )}
    </section>

    {latestNotes.length > 0 && (
      <section class="mt-20" id="writing" data-pagefind-ignore>
        <p class="section-label"><span class="section-num">04</span>Writing</p>

        <EntryList>
          {latestNotes.map((note) => (
            <EntryRow
              href={"/notes/" + note.id}
              title={note.data.title ?? note.id}
              date={note.data.pubDate}
            />
          ))}
        </EntryList>
      </section>
    )}
    </section>

    <section class="border-t mt-20 border-accent-3 pt-12 pb-6">
      <h2 class="font-display text-3xl md:text-4xl tracking-tight leading-[1.1] text-balance max-w-2xl">
        Let's make something <span class="italic">that matters</span>.
      </h2>
      <div class="mt-7 flex flex-wrap gap-2 text-sm">
        <a href="/contacts" class="btn-solid">Get in touch&nbsp;↗</a>
        <a href="https://github.com/jacksalici" class="btn-outline">GitHub&nbsp;↗</a>
        <a href="https://scholar.google.com/citations?user=jMVa-rYAAAAJ" class="btn-outline">Google Scholar&nbsp;↗</a>
        <a href="https://linkedin.com/in/jacksalici" class="btn-outline">LinkedIn&nbsp;↗</a>

      </div>
    </section>
  </main>
</Base>

<script>
  const toggle = document.querySelector(".read-toggle");
  const photo = document.querySelector<HTMLElement>(".snapshot")
  const panel = document.getElementById("bio-more");

  function setBio(open: boolean) {
    if (panel) panel.dataset.open = String(open);
    if (photo) photo.dataset.reading = String(open);
    if (!toggle) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "Read less ↖" : "Read more ↘";
  }

  toggle?.addEventListener("click", () => {
    setBio(panel?.dataset.open !== "true");
  });

  // The header's "About" link points at /#about and expects the long bio open.
  function openBioFromHash() {
    if (location.hash === "#about") setBio(true);
  }

  openBioFromHash();
  window.addEventListener("hashchange", openBioFromHash);
  // Clicking it while already at /#about fires no hashchange, so catch the click too.
  document.querySelectorAll('a[href$="#about"]').forEach((link) => {
    link.addEventListener("click", () => setBio(true));
  });

  const INITIAL_VISIBLE = 3;

  // "Show all" / "Show latest" toggle for a list of entries.
  function collapseList(list: Element) {
    Array.from(list.querySelectorAll(".entry")).forEach((entry, i) => {
      (entry as HTMLElement).hidden = i >= INITIAL_VISIBLE;
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".toggle-btn").forEach((btn) => {
    const list = btn.previousElementSibling;
    if (!list) return;
    const label = btn.querySelector(".toggle-label");

    btn.addEventListener("click", () => {
      const expanded = btn.dataset.expanded === "true";
      const nextExpanded = !expanded;

      Array.from(list.querySelectorAll(".entry")).forEach((entry, i) => {
        (entry as HTMLElement).hidden = nextExpanded ? false : i >= INITIAL_VISIBLE;
      });

      btn.dataset.expanded = String(nextExpanded);
      if (label) label.textContent = nextExpanded ? "Show latest ↖" : "Show all ↘";
    });
  });

  // Clicking an activity pins it over all page content, filters papers/projects
  // to its work, hides writing, and opens its details panel — click again to clear.
  const activityRail = document.querySelector<HTMLElement>(".activity-rail");
  const activityCards = document.querySelectorAll<HTMLAnchorElement>(".activity-card");
  const detailsPanel = document.getElementById("activity-details");
  const detailPanels = document.querySelectorAll<HTMLElement>(".activity-detail");
  const writingSection = document.getElementById("writing");

  const filterTargets = [
    { section: document.getElementById("papers"), list: document.getElementById("papers-list"), btn: document.querySelector<HTMLButtonElement>("#papers .toggle-btn") },
    { section: document.getElementById("projects"), list: document.getElementById("projects-list"), btn: document.querySelector<HTMLButtonElement>("#projects .toggle-btn") },
  ];

  let activeActivityId: string | null = null;

  function pinRail(pin: boolean) {
    if (activityRail) activityRail.dataset.pinned = String(pin);
  }

  function selectActivity(id: string | null) {
    activeActivityId = id;

    activityCards.forEach((card) => {
      const isActive = card.dataset.activityId === id;
      card.setAttribute("aria-pressed", String(isActive));
    });

    pinRail(Boolean(id));

    detailPanels.forEach((panel) => {
      panel.hidden = panel.dataset.activityId !== id;
    });
    if (detailsPanel) detailsPanel.dataset.open = String(Boolean(id));

    if (writingSection) writingSection.hidden = Boolean(id);

    filterTargets.forEach(({ section, list, btn }) => {
      if (!list) return;
      const entries = Array.from(list.querySelectorAll<HTMLElement>(".entry"));

      if (id) {
        let anyVisible = false;
        entries.forEach((entry) => {
          const matches = (entry.dataset.activities ?? "").split(" ").includes(id);
          entry.hidden = !matches;
          if (matches) anyVisible = true;
        });
        if (btn) btn.hidden = true;
        if (section) section.hidden = !anyVisible;
      } else {
        collapseList(list);
        if (btn) {
          btn.hidden = false;
          btn.dataset.expanded = "false";
          const label = btn.querySelector(".toggle-label");
          if (label) label.textContent = "Show all ↘";
        }
        if (section) section.hidden = false;
      }
    });
  }

  activityCards.forEach((card) => {
    card.addEventListener("click", (e) => {
      e.preventDefault();
      const id = card.dataset.activityId ?? null;
      const nextId = activeActivityId === id ? null : id;
      selectActivity(nextId);
      history.replaceState(null, "", nextId ? "#" + nextId : location.pathname + location.search);
    });
  });

  // Landing on (or navigating to) a #activity-id hash selects that activity.
  function openActivityFromHash() {
    const id = location.hash.slice(1);
    const matches = Array.from(activityCards).some((card) => card.dataset.activityId === id);
    if (matches) selectActivity(id);
  }

  openActivityFromHash();
  window.addEventListener("hashchange", openActivityFromHash);
</script>
