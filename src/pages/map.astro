---
import 'maplibre-gl/dist/maplibre-gl.css';

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const papers = await getCollection('papers');

const papersWithCoordinates = papers
  .filter((paper) => paper.data.coordinates)
  .map((paper) => ({
    id: paper.id,
    title: paper.data.title,
    location: paper.data.location,
    coordinates: paper.data.coordinates,
    venue: paper.data.venue || paper.data.acronym,
    pubDate: paper.data.pubDate,
    categories: paper.data.categories,
  }));
---

<Base
  title="Conference map"
  description="A map of paper venues and conference locations related to Giacomo Salici's publications."
  image="/website.jpg"
>
    <main>
        <h1 class="text-3xl mb-2">The Conference Atlas</h1>
        <p class="text-gray-500 mb-4">A map of paper venues and conference locations related to my publications.</p>
        <div id="map" class="min-w-full h-[70vh] rounded-xl lg:-mx-20"></div>
        <script type="application/json" id="papers-data" set:html={JSON.stringify(papersWithCoordinates)} />
    </main>
</Base>

<script src="../scripts/conference-map.ts"></script>

<style is:global>
  body {
    overflow: hidden;
  }
</style>
