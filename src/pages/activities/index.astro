---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import EntryRow from "../../components/EntryRow.astro";

const activities = (await getCollection("activities"))
  .filter((a) => a.data.draft !== true && a.data.hidden !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const props = { image: '/website.png' }
---

<Base
  title="Ongoing activities"
  description="Current research activities and topics Giacomo Salici is working on, from robotics to time-series analysis and V2X."
  image={props.image}
>
  <main>

    <p class="eyebrow mb-3">Research</p>
    <h1 class="mb-3 text-3xl md:text-4xl font-display font-bold">Ongoing activities</h1>
    <p class="mb-10 text-base text-neutral-content max-w-2xl">
      Projects I am currently working on. They may or may not become public or become a future publication.
    </p>

    <EntryList>
      {
        activities.map((activity) => (
          <EntryRow
            href={"/activities/" + activity.id}
            title={activity.data.title ?? activity.id}
            description={activity.data.description}
            date={activity.data.pubDate}
          />
        ))
      }
    </EntryList>
  </main>
</Base>
