---
import { getCollection } from "astro:content";
import { Layers } from "@lucide/astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Base from "../../layouts/Base.astro";

const activities = (await getCollection("activities"))
  .filter((a) => a.data.draft !== true && a.data.hidden !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const props = { image: '/website.png' }
---

<Base
  title="Ongoing activities"
  description="Current research activities and topics Giacomo Salici is working on, from robotics to time-series analysis and V2X."
  image={props.image}
>
  <main>

    <p class="eyebrow mb-3">Research</p>
    <h1 class="mb-3 text-3xl md:text-4xl font-display font-bold">Ongoing activities</h1>
    <p class="mb-10 text-base text-neutral-content max-w-2xl">
      Projects I am currently working on. They may or may not become public or become a future publication.
    </p>

    <ul class="flex flex-col gap-1">
      {
        activities.map((activity) => (
          <li>
            <a href={"/activities/" + activity.id} class="group flex items-start gap-3 py-2 hover:text-accent-1 transition-colors">
              <Layers size={14} class="shrink-0 mt-1 text-neutral-content group-hover:text-accent-1 transition-colors" />
              <span class="min-w-0 flex-1">
                <span class="block font-display font-bold">{activity.data.title}</span>
                {activity.data.description && (
                  <span class="block text-sm text-neutral-content mt-0.5">{activity.data.description}</span>
                )}
              </span>
              <span class="shrink-0 text-xs text-neutral-content">
                <FormattedDate date={activity.data.pubDate} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
