---
import { type CollectionEntry, render } from "astro:content";
import List from "../../components/List.astro";
import ListItem from "../../components/ListItem.astro";
import PageHeader from "../../components/PageHeader.astro";
import Prose from "../../components/Prose.astro";
import Section from "../../components/Section.astro";
import Base from "../../layouts/Base.astro";
import { newsKindLabels } from "../../consts";
import { getActivities, getNews } from "../../utils/news";

export async function getStaticPaths() {
  const [activities, news] = await Promise.all([getActivities(), getNews()]);
  return activities.map((activity) => ({
    params: { slug: activity.id },
    props: {
      activity,
      related: news.filter((item) => item.activities?.includes(activity.id)),
    },
  }));
}

type Props = {
  activity: CollectionEntry<"activities">;
  related: Awaited<ReturnType<typeof getNews>>;
};

const { activity, related } = Astro.props;
const { Content } = await render(activity);
---

<Base
  title={activity.data.title}
  description={activity.data.description}
  tags={activity.data.tags}
  pageType="website"
>
  <main>
    <PageHeader
      eyebrow={activity.data.kicker}
      title={activity.data.title ?? activity.id}
      lead={activity.data.description}
    />

    <Prose>
      <Content />
    </Prose>

    {related.length > 0 && (
      <Section title="Related work" data-pagefind-ignore>
        <List>
          {related.map((item) => (
            <ListItem href={item.href} title={item.title} date={item.date} chip={newsKindLabels[item.kind]} />
          ))}
        </List>
      </Section>
    )}
  </main>
</Base>
