---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import EntryRow from '../../components/EntryRow.astro';
import { categories } from '../../consts';

export async function getStaticPaths() {
	const activities = await getCollection('activities');
	return activities.map((activity) => ({
		params: { slug: activity.id },
		props: activity,
	}));
}

type Props = CollectionEntry<'activities'>;

const activity = Astro.props;
const { Content } = await render(activity);

const byNewest = (a: { data: { pubDate: Date } }, b: { data: { pubDate: Date } }) =>
	b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const linkedTo = (item: { data: { draft?: boolean; hidden?: boolean; activities?: string[] } }) =>
	item.data.draft !== true &&
	item.data.hidden !== true &&
	Array.isArray(item.data.activities) &&
	item.data.activities.includes(activity.id);

const projects = (await getCollection('projects')).filter(linkedTo).sort(byNewest);
const papers = (await getCollection('papers')).filter(linkedTo).sort(byNewest);
---

<Base {...activity.data}>
	<main>
		<p class="eyebrow mb-3">{activity.data.kicker}</p>
		<h1 class="text-3xl md:text-4xl font-display font-bold mb-4">{activity.data.title}</h1>

		{activity.data.description && (
			<p class="text-lg md:text-xl text-base-content/90 mb-8 max-w-2xl">{activity.data.description}</p>
		)}

		<div class="prose prose-js font-body mb-16 prose-p:text-justify prose-p:hyphens-auto w-full">
			<Content />
		</div>

		{papers.length > 0 && (
			<section class="mb-16 not-prose">
				<p class="section-label">Related papers</p>
				<EntryList>
					{papers.map((paper) => (
						<EntryRow
							href={'/papers/' + paper.id}
							title={paper.data.title ?? paper.id}
							meta={paper.data.acronym}
							date={paper.data.pubDate}
						/>
					))}
				</EntryList>
			</section>
		)}

		{projects.length > 0 && (
			<section class="mb-16 not-prose">
				<p class="section-label">Related projects</p>
				<EntryList>
					{projects.map((project) => (
						<EntryRow
							href={'/projects/' + project.id}
							title={project.data.title ?? project.id}
							meta={
								project.data.categories?.[0]
									? (categories[project.data.categories[0]] ?? project.data.categories[0])
									: undefined
							}
							date={project.data.pubDate}
						/>
					))}
				</EntryList>
			</section>
		)}
	</main>
</Base>
