---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import EntryRow from "../../components/EntryRow.astro";
import { categories } from "../../consts";

const projects = (await getCollection("projects"))
  .filter((a) => a.data.draft !== true && a.data.hidden !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryOf = (p: (typeof projects)[number]) =>
  p.data.categories?.[0] ? (categories[p.data.categories[0]] ?? p.data.categories[0]) : undefined;
---

<Base
  title="Projects"
  description="Projects built by Giacomo Salici, from research prototypes to web products and hardware."
  image="/website.jpg"
>
  <main>
    <p class="eyebrow mb-3">Portfolio</p>
    <h1 class="mb-8 text-3xl md:text-4xl font-display font-bold">Projects</h1>



    <EntryList id="project-list">
      {
        projects.map((project) => (
          <EntryRow
            href={"/projects/" + project.id}
            title={project.data.title ?? project.id}
            meta={categoryOf(project)}
            date={project.data.pubDate}
            search={[
              project.data.title,
              categoryOf(project),
              project.data.description,
              project.data.stack?.join(" "),
            ]
              .filter(Boolean)
              .join(" ")}
          />
        ))
      }
    </EntryList>

  </main>
</Base>
